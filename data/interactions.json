[{"id":"simva-clari","a":"simvastatin","b":"clarithromycin","severity":"contraindicated","effect":"Kadar simvastatin meningkat tajam → miopati/rabdomiolisis.","mechanism":"Inhibisi kuat CYP3A4.","management":"Kontraindikasi. Hentikan sementara simvastatin selama terapi klaritromisin atau pilih makrolida lain (azitromisin).","sources":[{"title":"FDA Drug Safety Communication: new restrictions, contraindications and dose limitations for simvastatin","publisher":"U.S. FDA","year":2011,"type":"regulatory"},{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"simva-amlo","a":"simvastatin","b":"amlodipine","severity":"moderate","effect":"Peningkatan paparan simvastatin → risiko miopati.","mechanism":"Inhibisi CYP3A4 lemah.","management":"Batasi simvastatin maksimal 20 mg/hari.","sources":[{"title":"FDA Drug Safety Communication: new restrictions, contraindications and dose limitations for simvastatin","publisher":"U.S. FDA","year":2011,"type":"regulatory"}],"review_status":"draft"},{"id":"domp-clari","a":"domperidone","b":"clarithromycin","severity":"contraindicated","effect":"Peningkatan kadar domperidon + efek aditif pemanjangan QT → aritmia ventrikel.","mechanism":"Inhibisi CYP3A4 + efek QT aditif.","management":"Kontraindikasi (EMA 2014).","sources":[{"title":"EMA: Domperidone-containing medicines — Article 31 referral (restrictions on use)","publisher":"European Medicines Agency","year":2014,"url":"https://www.ema.europa.eu/en/medicines/human/referrals/domperidone-containing-medicines","type":"regulatory"}],"review_status":"draft"},{"id":"qt-additive","a":"class:qt","b":"class:qt","severity":"major","effect":"Efek aditif perpanjangan QT → risiko torsades de pointes.","management":"Hindari kombinasi bila memungkinkan; bila perlu: EKG awal, koreksi K/Mg, pantau QTc.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-nsaid","a":"warfarin","b":"class:nsaid","severity":"major","effect":"Risiko perdarahan (terutama GI) meningkat.","mechanism":"Efek antiplatelet + iritasi mukosa GI.","management":"Hindari; gunakan paracetamol dosis terbatas. Bila tak terhindarkan: PPI + pemantauan ketat.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-antiplatelet","a":"warfarin","b":"class:antiplatelet","severity":"major","effect":"Risiko perdarahan meningkat bermakna.","management":"Hanya bila ada indikasi jelas (keputusan spesialis); pantau perdarahan, pertimbangkan gastroproteksi.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-metro","a":"warfarin","b":"metronidazole","severity":"major","effect":"INR meningkat bermakna → perdarahan.","mechanism":"Inhibisi metabolisme S-warfarin (CYP2C9).","management":"Hindari atau kurangi dosis warfarin dan cek INR dalam 3–5 hari.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-cotri","a":"warfarin","b":"cotrimoxazole","severity":"major","effect":"INR meningkat bermakna → perdarahan.","mechanism":"Inhibisi CYP2C9 + pergeseran ikatan protein.","management":"Hindari; bila perlu, pantau INR ketat dan kurangi dosis warfarin.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-cipro","a":"warfarin","b":"ciprofloxacin","severity":"moderate","effect":"INR dapat meningkat.","management":"Pantau INR selama dan setelah terapi.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-clari","a":"warfarin","b":"clarithromycin","severity":"moderate","effect":"INR dapat meningkat.","management":"Pantau INR.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-azi","a":"warfarin","b":"azithromycin","severity":"moderate","effect":"Laporan peningkatan INR.","management":"Pantau INR.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"warf-pct","a":"warfarin","b":"paracetamol","severity":"minor","effect":"Penggunaan reguler paracetamol (>2 g/hari selama beberapa hari) dapat meningkatkan INR.","management":"Penggunaan sesekali aman; bila reguler, pantau INR.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"}],"review_status":"draft"},{"id":"clop-omep","a":"clopidogrel","b":"omeprazole","severity":"moderate","effect":"Penurunan aktivasi klopidogrel → efek antiplatelet berkurang.","mechanism":"Inhibisi CYP2C19.","management":"Hindari; gunakan pantoprazol bila perlu PPI.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"aspirin-ibu","a":"aspirin","b":"ibuprofen","severity":"moderate","effect":"Ibuprofen dapat mengganggu efek antiplatelet aspirin dosis rendah; risiko perdarahan GI meningkat.","management":"Hindari penggunaan rutin; bila perlu, beri ibuprofen ≥30 menit setelah aspirin IR (atau >8 jam sebelumnya).","sources":[{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"antiplt-nsaid","a":"class:antiplatelet","b":"class:nsaid","severity":"moderate","effect":"Risiko perdarahan GI meningkat.","management":"Hindari bila memungkinkan; pertimbangkan PPI.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"acei-nsaid","a":"captopril","b":"class:nsaid","severity":"moderate","effect":"Penurunan efek antihipertensi; risiko AKI dan hiperkalemia (\"triple whammy\" bila + diuretik).","management":"Hindari pada lansia/CKD/dehidrasi; bila perlu, pantau kreatinin & kalium.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"acei-furo","a":"captopril","b":"furosemide","severity":"moderate","effect":"Hipotensi dosis pertama; penurunan fungsi ginjal pada hipovolemia.","management":"Mulai ACEi dosis rendah; pertimbangkan pengurangan diuretik sementara; pantau TD & kreatinin.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"furo-nsaid","a":"furosemide","b":"class:nsaid","severity":"moderate","effect":"Penurunan efek diuretik & risiko AKI.","management":"Hindari bila memungkinkan; pantau fungsi ginjal.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"glib-cotri","a":"glibenclamide","b":"cotrimoxazole","severity":"moderate","effect":"Risiko hipoglikemia meningkat.","management":"Pantau gula darah; edukasi hipoglikemia.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"glib-clari","a":"glibenclamide","b":"clarithromycin","severity":"moderate","effect":"Laporan hipoglikemia berat.","management":"Pantau gula darah; pertimbangkan antibiotik lain.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"glib-cipro","a":"glibenclamide","b":"ciprofloxacin","severity":"moderate","effect":"Disglikemia (terutama hipoglikemia) pada pengguna sulfonilurea.","management":"Pantau gula darah.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"cipro-zinc","a":"ciprofloxacin","b":"zinc","severity":"moderate","effect":"Absorpsi siprofloksasin menurun (khelasi).","management":"Minum siprofloksasin ≥2 jam sebelum atau 6 jam setelah zink.","sources":[{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"diaz-mg","a":"diazepam","b":"magnesium-sulfate","severity":"moderate","effect":"Depresi SSP/napas aditif.","management":"Bila keduanya diperlukan, pantau laju napas & kesadaran ketat.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"}],"review_status":"draft"},{"id":"raas-dual","a":"captopril","b":"losartan","severity":"major","effect":"Blokade ganda RAAS: hiperkalemia, hipotensi, AKI tanpa manfaat tambahan.","management":"Hindari kombinasi ACEi + ARB.","sources":[{"title":"2023 ESH Guidelines for the management of arterial hypertension. J Hypertens 2023;41:1874","publisher":"European Society of Hypertension","year":2023,"type":"guideline"},{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"raas-spiro","a":"class:raas","b":"spironolactone","severity":"moderate","effect":"Risiko hiperkalemia meningkat.","management":"Boleh dikombinasikan (mis. gagal jantung) dengan pemantauan kalium & kreatinin 1 dan 4 minggu; hindari bila K >5,0 atau eGFR <30.","sources":[{"title":"McDonagh TA et al. 2021 ESC Guidelines for the diagnosis and treatment of acute and chronic heart failure. Eur Heart J 2021;42:3599","publisher":"ESC","year":2021,"type":"guideline"}],"review_status":"draft"},{"id":"raas-nsaid","a":"losartan","b":"class:nsaid","severity":"moderate","effect":"Penurunan efek antihipertensi; risiko AKI & hiperkalemia.","management":"Hindari pada lansia/CKD/dehidrasi; pantau kreatinin & kalium.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"inducer-warf","a":"class:inducer","b":"warfarin","severity":"major","effect":"Induksi enzim menurunkan kadar warfarin → INR turun (risiko trombosis); saat penginduksi dihentikan INR dapat naik.","management":"Pantau INR ketat saat mulai/berhenti; penyesuaian dosis warfarin besar sering diperlukan.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"fluco-warf","a":"fluconazole","b":"warfarin","severity":"major","effect":"INR meningkat bermakna (inhibisi CYP2C9).","management":"Hindari atau kurangi dosis warfarin dan pantau INR dalam 3–5 hari.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"fluco-statin","a":"fluconazole","b":"simvastatin","severity":"moderate","effect":"Peningkatan kadar simvastatin → risiko miopati.","management":"Pertimbangkan menunda statin selama terapi flukonazol jangka pendek; pantau gejala otot.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"fluco-su","a":"fluconazole","b":"glimepiride","severity":"moderate","effect":"Peningkatan kadar sulfonilurea → hipoglikemia.","management":"Pantau gula darah.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"clari-atorva","a":"clarithromycin","b":"atorvastatin","severity":"major","effect":"Peningkatan kadar atorvastatin → miopati/rabdomiolisis.","management":"Batasi atorvastatin (label: hati-hati di atas 20 mg) atau tunda statin selama terapi; pertimbangkan azitromisin.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"clari-ergo","a":"clarithromycin","b":"methylergometrine","severity":"contraindicated","effect":"Ergotisme (vasospasme, iskemia) akibat inhibisi CYP3A4.","management":"Kontraindikasi.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"doxy-iron","a":"doxycycline","b":"ferrous-sulfate","severity":"moderate","effect":"Absorpsi doksisiklin menurun (khelasi).","management":"Pisahkan pemberian ≥2–3 jam.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"cipro-iron","a":"ciprofloxacin","b":"ferrous-sulfate","severity":"moderate","effect":"Absorpsi siprofloksasin menurun (khelasi).","management":"Siprofloksasin ≥2 jam sebelum atau 6 jam setelah besi.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"enox-bleed","a":"enoxaparin","b":"class:antiplatelet","severity":"major","effect":"Risiko perdarahan meningkat.","management":"Kombinasi hanya bila indikasi jelas (mis. SKA) dengan pemantauan; pertimbangkan gastroproteksi.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"enox-nsaid","a":"enoxaparin","b":"class:nsaid","severity":"major","effect":"Risiko perdarahan meningkat.","management":"Hindari; gunakan paracetamol.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"tram-ondan","a":"tramadol","b":"ondansetron","severity":"moderate","effect":"Risiko sindrom serotonin; ondansetron dapat menurunkan efek analgesik tramadol.","management":"Pantau gejala serotonergik; pertimbangkan antiemetik lain.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"},{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"tram-diaz","a":"tramadol","b":"diazepam","severity":"major","effect":"Depresi SSP dan napas aditif (opioid + benzodiazepin).","management":"Hindari kombinasi; bila perlu, dosis terendah dan pemantauan napas.","sources":[{"title":"FDA Prescribing Information (DailyMed)","publisher":"U.S. NLM / FDA","url":"https://dailymed.nlm.nih.gov","type":"label"}],"review_status":"draft"},{"id":"meto-domp","a":"metoclopramide","b":"domperidone","severity":"moderate","effect":"Duplikasi antagonis dopamin — efek samping aditif tanpa manfaat tambahan.","management":"Hindari kombinasi.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"}],"review_status":"draft"},{"id":"bb-glib","a":"bisoprolol","b":"glibenclamide","severity":"minor","effect":"Penyekat beta dapat menutupi gejala adrenergik hipoglikemia.","management":"Edukasi gejala hipoglikemia non-adrenergik (berkeringat tetap muncul); pantau gula darah.","sources":[{"title":"British National Formulary (BNF)","publisher":"BMJ / Royal Pharmaceutical Society","url":"https://bnf.nice.org.uk","type":"formulary"}],"review_status":"draft"}]